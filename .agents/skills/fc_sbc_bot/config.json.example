{
  "setup_mode": false,
  "delays": {
    "before_build_min": 1.5,
    "before_build_max": 3.0,
    "after_build_min": 2.5,
    "after_build_max": 4.5,
    "after_submit_min": 1.5,
    "after_submit_max": 3.0,
    "batch_size": 10,
    "batch_rest_seconds": 60
  },
  "telegram": {
    "enabled": false,
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID"
  },
  "workflow": [
    {
      "step": 1,
      "type": "sbc",
      "sbc_name": "Daily Bronze Upgrade",
      "max_repeats": -1,
      "save_count_key": "bronze_success_count",
      "supply_pack_name": "BRONZE PLAYERS PREMIUM"
    },
    {
      "step": 2,
      "type": "open_pack",
      "pack_name": "BRONZE PLAYERS PREMIUM",
      "count_key": "bronze_success_count"
    },
    {
      "step": 3,
      "type": "sbc",
      "sbc_name": "Daily Silver Upgrade",
      "max_repeats": -1,
      "save_count_key": "silver_success_count",
      "supply_pack_name": "SILVER PLAYERS PREMIUM"
    },
    {
      "step": 4,
      "type": "open_pack",
      "pack_name": "SILVER PLAYERS PREMIUM",
      "count_key": "silver_success_count"
    },
    {
      "step": 5,
      "type": "sbc",
      "sbc_name": "Daily Common Gold Upgrade",
      "max_repeats": -1
    },
    {
      "step": 6,
      "type": "open_pack",
      "pack_name": "11x Gold Players Pack",
      "open_all": true
    },
    {
      "step": 7,
      "type": "sbc",
      "sbc_name": "Bronze Upgrade",
      "max_repeats": -1
    },
    {
      "step": 8,
      "type": "open_pack",
      "pack_name": "x2 Silver Players Pack",
      "open_all": true
    },
    {
      "step": 9,
      "type": "sbc",
      "sbc_name": "Silver Upgrade",
      "max_repeats": -1
    },
    {
      "step": 10,
      "type": "open_pack",
      "pack_name": "x3 Common Gold Players Pack",
      "open_all": true
    },
    {
      "step": 11,
      "type": "sbc",
      "sbc_name": "Daily Rare Gold Upgrade",
      "max_repeats": -1
    },
    {
      "step": 12,
      "type": "open_pack",
      "pack_name": "5x Max. 78 Rare Gold Players Pack",
      "open_all": true
    },
    {
      "step": 13,
      "type": "sbc",
      "sbc_name": "Provisions Upgrade",
      "max_repeats": -1
    },
    {
      "step": 14,
      "type": "open_pack",
      "pack_name": "Provisions Pack",
      "open_all": true
    },
    {
      "step": 15,
      "type": "sbc",
      "sbc_name": "5x 80+ Upgrade",
      "max_repeats": -1
    },
    {
      "step": 16,
      "type": "open_pack",
      "pack_name": "5x 80+ Rare Gold Players Pack",
      "open_all": true
    },
    {
      "step": 17,
      "type": "sbc",
      "sbc_name": "2 of 3 87+ Player Pick",
      "max_repeats": -1
    },
    {
      "step": 18,
      "type": "sbc",
      "sbc_name": "1 of 3 85+ Player Pick",
      "max_repeats": -1
    }
  ]
}